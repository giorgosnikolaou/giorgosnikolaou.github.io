---
import { siteConfig } from "../config";
const hasAwards = siteConfig.awards && siteConfig.awards.length > 0;
---

{
  hasAwards && (
    <section id="awards" class="p-8 sm:p-12 md:p-16 lg:p-24" data-nav-label="Awards">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
        <div class="lg:col-span-4">
          <h2 class="h2">Awards &amp; Grants</h2>
          <div
            class="w-[75px] h-[5px] mt-2 rounded-full"
            style={`background-color: ${siteConfig.accentColor}`}
          />
        </div>

        <div class="lg:col-span-8">
          <ul class="space-y-6">
            {siteConfig.awards.map((award) => (
              <li class="surface-card rounded-lg p-4 sm:p-5 md:p-6">
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 sm:gap-6">
                  <div>
                    <h3 class="h5">{award.name}</h3>
                    <p class="body mt-2" style={`color: ${siteConfig.accentColor}`}>
                      {award.organization}
                      {award.detail && (
                        <span class="body-sm">
                          {" — "}<span set:html={award.detail} />
                        </span>
                      )}
                    </p>
                  </div>
                  <span class="body-sm shrink-0">{award.year}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )
}
